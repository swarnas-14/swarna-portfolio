# ── Contact Form Configuration ────────────────────────────────────────────────
# Get your free access key at https://web3forms.com (No backend required)
# Submissions from your portfolio contact form will be emailed directly to you.
# Supports either WEB3FORMS_ACCESS_KEY or VITE_WEB3FORMS_ACCESS_KEY
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# (Optional) Alternatively, specify your own custom serverless/form submission endpoint
# VITE_CONTACT_FORM_ENDPOINT=https://your-custom-api.com/contact

# ── Local Development Admin Credentials ──────────────────────────────────────
# Convenience access gate for local editing at http://localhost:5173/admin
# These credentials only work in local development (never active in production)
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=YOUR_LOCAL_ADMIN_PASSWORD
